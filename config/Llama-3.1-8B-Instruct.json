{
    "AdaptiveIMI": {
        "static_pattern_start": 4,
        "static_pattern_end": 64,
        "core": 24,
        "pages_per_cluster": 2,
        "cache_ratio": 0.1,
        "retrieval_budget": 0.1,
        "buffer_cluster_num": 32,
        "gpu_only": false,
        "engine": "hybrid_8way_v2",
        "subspace_parts": 8,
        "partition_path": "outputs/imi_partition/llama3_partition.json",
        "hybrid_index": {
            "policy": "alternate",
            "start": "cpu",
            "cpu_build_concurrency": 1,
            "max_gpu_raw_slots": 4
        },
        "cache": {
            "execution_buffer_ring_size": 2
        },
        "kmeans": {
            "max_iters": 10,
            "tol": 0.0005,
            "early_stop_min_iter": 10,
            "early_stop_rel_tol": 0.0005,
            "fp32_convert_chunk_elems": 1048576
        },
        "prefetch": {
            "enabled": true,
            "ratio": 0.1,
            "mode": "random",
            "seed": 0,
            "tiles_per_layer": 1
        },
        "prefill": {
            "prefill_chunk_size": 131072
        },
        "streaming": {
            "hidden_device": "auto",
            "hidden_gpu_limit_gb": 8.0,
            "hidden_pinned_limit_gb": 8.0
        },
        "async_update": {
            "enabled": false,
            "batch": 16,
            "threshold": 16,
            "delta_tokens": 512
        },
        "cpu_threads": 24
    }
}
