{
    "model_path": "../models/Qwen3-8B",
    "AdaptiveIMI": {
        "static_pattern_start": 4,
        "static_pattern_end": 64,
        "retrieval_budget": 0.1,
        "buffer_cluster_num": 32,
        "cache_ratio": 0.05,
        "partition_path": "outputs/train_data/partitions/booksum_nolima_babilong_constrained_mse_cap96_alltokens_tokentrim_search32x384/qwen3_partition.json",
        "hybrid_index": {
            "policy": "gpu_only",
            "start": "gpu"
        },
        "cache": {
            "execution_buffer_ring_size": 2,
            "cluster_uva_warmup_steps": 0,
            "promotion_warmup_steps": 4,
            "promotion_start_step": 2
        },
        "kmeans": {
            "max_iters": 15
        },
        "prefill": {
            "prefill_chunk_size": 16384
        },
        "streaming": {
            "hidden_device": "auto",
            "hidden_gpu_limit_gb": 8.0,
            "hidden_pinned_limit_gb": 8.0
        },
        "async_update": {
            "enabled": true,
            "mode": "unified_pages",
            "recent_generated_tokens": 512,
            "interval": 16,
            "pages_per_probe": 8,
            "total_token_budget": 256,
            "generated_token_reserve": 128
        },
        "cpu_threads": 24
    }
}
