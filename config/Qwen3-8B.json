{
    "model_path": "../models/Qwen3-8B",
    "AdaptiveIMI": {
        "static_pattern_start": 4,
        "static_pattern_end": 64,
        "retrieval_budget": 0.1,
        "buffer_cluster_num": 32,
        "cache_ratio": 0.1,
        "partition_path": "outputs/train_data/partitions/real100_ruler100_mixed_128k_heavy/qwen3_partition.json",
        "hybrid_index": {
            "policy": "gpu_only",
            "start": "gpu"
        },
        "cache": {
            "execution_buffer_ring_size": 2,
            "cluster_uva_warmup_steps": 3,
            "promotion_warmup_steps": 4
        },
        "kmeans": {
            "max_iters": 15
        },
        "prefill": {
            "prefill_chunk_size": 16384
        },
        "streaming": {
            "hidden_device": "auto",
            "hidden_gpu_limit_gb": 8.0,
            "hidden_pinned_limit_gb": 8.0
        },
        "async_update": {
            "enabled": true,
            "recent_generated_tokens": 512,
            "interval": 16,
            "delta_nprobe": 8
        },
        "cpu_threads": 24
    }
}
